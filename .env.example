# ==============================================================================
# AI Podcast Generator - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Cost Comparison (per 10-min episode, ~2K output tokens):
# - Claude Sonnet:     ~$0.03  (best quality)
# - Together (Qwen):   ~$0.002 (good quality, 15x cheaper)
# - Groq (Llama):      ~$0.002 (fast, 15x cheaper)
# - Ollama:            FREE    (requires local setup)
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Selection (pick one)
# ------------------------------------------------------------------------------
# Options: anthropic, together, groq, fireworks, ollama, openai
# Default: anthropic
LLM_PROVIDER=together

# ------------------------------------------------------------------------------
# API Keys (set the one matching your LLM_PROVIDER)
# ------------------------------------------------------------------------------

# Claude (Anthropic) - Best quality for creative writing
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Together.ai - Qwen, Llama, Mixtral (recommended for experiments)
# Get key: https://api.together.xyz/
# Free tier: $25 credits
TOGETHER_API_KEY=

# Groq - Ultra-fast inference (LPU)
# Get key: https://console.groq.com/
# Free tier: 14k tokens/min
GROQ_API_KEY=

# Fireworks.ai - Fast inference
# Get key: https://fireworks.ai/
FIREWORKS_API_KEY=

# OpenAI - GPT models
# Get key: https://platform.openai.com/
OPENAI_API_KEY=

# Ollama - Local models (no key needed)
# Install: https://ollama.ai/
# Then run: ollama pull qwen2.5:32b
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Optional: Specific Model Override
# ------------------------------------------------------------------------------
# Leave empty to use recommended model for your provider
# Examples:
#   TOGETHER: Qwen/Qwen2.5-72B-Instruct, meta-llama/Llama-3.3-70B-Instruct-Turbo
#   GROQ: llama-3.3-70b-versatile, llama-3.1-8b-instant
#   ANTHROPIC: claude-sonnet-4-20250514
#   OLLAMA: qwen2.5:32b, llama3.2:latest
LLM_MODEL=

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# Output directory for generated podcasts
OUTPUT_DIR=./output

# Knowledge Graph database path
KG_DATABASE_PATH=./data/podcast_kg

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Enable debug mode
DEBUG=false

# ------------------------------------------------------------------------------
# Audio Settings
# ------------------------------------------------------------------------------
# TTS Provider: vibevoice, gtts
TTS_PROVIDER=gtts

# VibeVoice requires GPU - falls back to gTTS if not available
# VIBEVOICE_MODEL_PATH=./models/vibevoice
